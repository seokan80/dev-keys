---
import Base from '../layouts/Base.astro';
import Playground from '../components/playground/Playground';
---

<Base title="연습장 — DevKeys" noindex>
  <main class="mx-auto flex max-w-4xl flex-col gap-6 px-6 py-10">
    <header class="flex flex-col gap-1">
      <h1 class="text-2xl font-bold">연습장</h1>
      <p class="text-sm text-slate-400">개발용 페이지 — 아무 글이나 넣고 따라쳐 봅니다.</p>
    </header>
    <Playground client:load />
  </main>
</Base>

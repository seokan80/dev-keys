---
import Base from '../layouts/Base.astro';
import { getSets } from '../lib/content/load';
import { CATEGORIES } from '../schemas/categories';

const sets = getSets();
---

<Base title="DevKeys — 개발자 타자 연습">
  <main class="mx-auto flex min-h-dvh max-w-3xl flex-col justify-center gap-8 px-6 py-10">
    <header class="flex flex-col gap-3">
      <h1 class="font-mono text-4xl font-bold">DevKeys</h1>
      <p class="text-lg text-slate-300">Git 명령과 코드를 따라 치며 손에 익히는 개발자용 타자 연습.</p>
    </header>
    <ul class="grid gap-3 sm:grid-cols-3">
      {CATEGORIES.map((category) => (
        <li>
          <a
            href={`/${category.id}`}
            class="flex h-full flex-col gap-1 rounded-lg border border-slate-700 p-4 hover:bg-slate-900"
          >
            <strong class="font-mono text-lg">{category.title}</strong>
            <span class="text-sm text-slate-400">{category.description}</span>
            <span class="text-xs text-slate-500">세트 {sets.filter((s) => s.category === category.id).length}개</span>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Base>

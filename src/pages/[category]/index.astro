---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getSets } from '../../lib/content/load';
import { challengeHref } from '../../lib/content/next';
import { CATEGORIES } from '../../schemas/categories';

export function getStaticPaths() {
  return CATEGORIES.map((category) => ({ params: { category: category.id }, props: { category } }));
}

const { category } = Astro.props;
const sets = getSets().filter((s) => s.category === category.id);
---

<Base
  title={`${category.title} 타자 연습 — DevKeys`}
  description={`${category.description}. 따라 치며 손에 익히는 개발자 타자 연습.`}
>
  <main class="mx-auto flex max-w-3xl flex-col gap-6 px-6 py-10">
    <Breadcrumb items={[{ label: 'DevKeys', href: '/' }, { label: category.title }]} />
    <header class="flex flex-col gap-1">
      <h1 class="text-3xl font-bold">{category.title} 타자 연습</h1>
      <p class="text-slate-400">{category.description}</p>
    </header>
    {category.id === 'git' && (
      <a
        href="/git/tree"
        class="flex flex-col gap-1 rounded-lg border border-emerald-700/70 bg-emerald-500/5 p-4 hover:bg-emerald-500/10"
        data-testid="tree-missions-card"
      >
        <span class="text-xs text-emerald-300">그림으로 익히기</span>
        <strong class="text-lg">트리 미션</strong>
        <span class="text-sm text-slate-400">명령을 쳐서 커밋 트리를 목표 모양으로 — merge · rebase · cherry-pick</span>
      </a>
    )}
    {sets.length === 0 ? (
      <p class="text-slate-500">준비 중입니다.</p>
    ) : (
      <ol class="flex flex-col gap-3">
        {sets.map((set) => (
          <li class="flex rounded-lg border border-slate-700">
            <a href={set.href} class="flex flex-1 flex-col gap-1 rounded-l-lg p-4 hover:bg-slate-900">
              <strong class="text-lg">{set.title}</strong>
              <span class="text-sm text-slate-400">{set.description}</span>
              <span class="text-xs text-slate-500">
                {set.lines.length}줄{set.recalls.length > 0 && ` · 도전 ${set.recalls.length}문제`} · 난이도 {set.level}
              </span>
            </a>
            {set.recalls.length > 0 && (
              <a
                href={challengeHref(set)}
                class="flex items-center rounded-r-lg border-l border-slate-700 px-4 text-sm text-amber-300 hover:bg-amber-500/10"
                aria-label={`도전 모드: ${set.title}`}
              >
                도전 →
              </a>
            )}
          </li>
        ))}
      </ol>
    )}
  </main>
</Base>

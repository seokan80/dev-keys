---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import MobileNotice from '../../components/site/MobileNotice';
import ReportLink from '../../components/site/ReportLink.astro';
import SetPlayer from '../../components/sets/SetPlayer';
import type { ContentSet } from '../../lib/content/check';
import { getSets } from '../../lib/content/load';
import { challengeHref, nextSetOf } from '../../lib/content/next';
import { categoryOf } from '../../schemas/categories';

export function getStaticPaths() {
  return getSets().map((set) => ({ params: { category: set.category, set: set.slug }, props: { set } }));
}

const { set } = Astro.props as { set: ContentSet };
const category = categoryOf(set.category);
const nextSet = nextSetOf(getSets(), set);
const challenge = set.recalls.length > 0 ? challengeHref(set) : undefined;
// 그림(상태 그림 · 커밋 그래프)이 있으면 타자 영역 옆에 칸을 두니 페이지를 넓게
const hasPanel = set.graph !== null || set.lines.some((l) => l.scene !== null);
const next = nextSet ? { href: nextSet.href, title: nextSet.title, description: nextSet.description } : null;

const guide = await getEntry('guides', `${set.category}/${set.slug}`);
if (!guide) throw new Error(`해설이 없다: ${set.category}/${set.slug}`);
const { Content } = await render(guide);
---

<Base title={`${set.title} — ${category.title} 명령 따라 치며 익히기 · DevKeys`} description={set.description}>
  <main class={`mx-auto flex ${hasPanel ? 'max-w-6xl' : 'max-w-4xl'} flex-col gap-6 px-6 py-10`}>
    <Breadcrumb
      items={[
        { label: 'DevKeys', href: '/' },
        { label: category.title, href: `/${set.category}` },
        { label: set.title },
      ]}
    />
    <header class="flex flex-col gap-1">
      <h1 class="text-3xl font-bold">{set.title}</h1>
      <p class="text-slate-400">{set.description}</p>
      <div class="flex flex-wrap gap-4 text-sm">
        <a href="#guide" class="text-sky-300 hover:underline">
          해설 읽기 ↓
        </a>
        {challenge && (
          <a href={challenge} class="text-amber-300 hover:underline" data-testid="challenge-link">
            도전 모드: 뜻 보고 치기 →
          </a>
        )}
      </div>
    </header>

    <MobileNotice client:only="react" guideHref="#guide" />

    <SetPlayer
      client:load
      setId={set.id}
      href={set.href}
      lines={set.lines}
      next={next}
      commentMark={category.comment}
      prompt={'prompt' in category ? category.prompt : undefined}
      outputMark={'result' in category ? category.result : undefined}
      guideHref="#guide"
      challengeHref={challenge}
      graph={set.graph}
    />

    <article id="guide" class="guide scroll-mt-6 border-t border-slate-800 pt-6">
      <p class="mb-2 text-xs font-bold tracking-widest text-sky-300 uppercase">해설</p>
      <Content />
    </article>
    <ReportLink what={`${category.title} 세트 · ${set.title} (${set.id})`} />
  </main>
</Base>

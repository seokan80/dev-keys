---
import Base from '../../../layouts/Base.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { getMissions } from '../../../lib/content/load';

const missions = getMissions();
---

<Base
  title="Git 트리 미션 — DevKeys"
  description="git 명령을 직접 쳐서 커밋 트리를 목표 모양으로 만드는 미션. branch · merge · rebase · cherry-pick 을 그림으로 익힌다."
>
  <main class="mx-auto flex max-w-3xl flex-col gap-6 px-6 py-10">
    <Breadcrumb items={[{ label: 'DevKeys', href: '/' }, { label: 'Git', href: '/git' }, { label: '트리 미션' }]} />
    <header class="flex flex-col gap-1">
      <h1 class="text-3xl font-bold">Git 트리 미션</h1>
      <p class="text-slate-400">
        명령을 쳐서 커밋 트리를 목표 모양으로 만든다. 어떤 명령을 썼든 결과가 같으면 성공이다.
      </p>
    </header>
    <ol class="flex flex-col gap-3">
      {missions.map((m) => (
        <li>
          <a href={m.href} class="flex flex-col gap-1 rounded-lg border border-slate-700 p-4 hover:bg-slate-900">
            <strong class="text-lg">{m.title}</strong>
            <span class="text-sm text-slate-400">{m.description}</span>
            <span class="text-xs text-slate-500">
              권장 명령 {m.solution.length}개 · 제한 {Math.round(m.timeLimitSec / 60)}분 · 난이도 {m.level}
            </span>
          </a>
        </li>
      ))}
    </ol>
  </main>
</Base>

---
import { getEntry, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import MissionPanel from '../../../components/git/MissionPanel';
import type { ContentMission } from '../../../lib/content/missions';
import { getMissions } from '../../../lib/content/load';

export function getStaticPaths() {
  return getMissions().map((mission) => ({ params: { mission: mission.slug }, props: { mission } }));
}

const { mission } = Astro.props as { mission: ContentMission };
const missions = getMissions();
const nextMission = missions[missions.indexOf(missions.find((m) => m.id === mission.id)!) + 1];
const guide = await getEntry('guides', `missions/${mission.slug}`);
if (!guide) throw new Error(`해설이 없다: missions/${mission.slug}`);
const { Content } = await render(guide);
---

<Base title={`${mission.title} — Git 트리 미션 · DevKeys`} description={mission.description}>
  <main class="mx-auto flex max-w-5xl flex-col gap-6 px-6 py-10">
    <Breadcrumb
      items={[
        { label: 'DevKeys', href: '/' },
        { label: 'Git', href: '/git' },
        { label: '트리 미션', href: '/git/tree' },
        { label: mission.title },
      ]}
    />
    <header class="flex flex-col gap-2">
      <h1 class="text-3xl font-bold">{mission.title}</h1>
      <p class="whitespace-pre-line text-slate-300">{mission.story}</p>
      <a href="#guide" class="text-sm text-sky-300 hover:underline">
        해설 읽기 ↓
      </a>
    </header>

    <!-- 그림 · 입력은 브라우저에서만 (검색 노출은 위 설명과 아래 해설로) -->
    <MissionPanel
      client:only="react"
      title={mission.title}
      timeLimitSec={mission.timeLimitSec}
      start={mission.startState}
      solution={mission.solution}
      next={nextMission ? { href: nextMission.href, title: nextMission.title } : null}
      guideHref="#guide"
    >
      <p slot="fallback" class="text-slate-500">
        불러오는 중…
      </p>
    </MissionPanel>

    <article id="guide" class="guide scroll-mt-6 border-t border-slate-800 pt-6">
      <p class="mb-2 text-xs font-bold tracking-widest text-sky-300 uppercase">해설</p>
      <Content />
    </article>
  </main>
</Base>
